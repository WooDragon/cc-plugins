#!/usr/bin/env bash
# Fixture: a fake grok. Prints a fixed result line.
if [ -n "${FAKE_GROK_ARGS_LOG:-}" ]; then
  printf '%s\n' "$@" >"$FAKE_GROK_ARGS_LOG"
fi
mode="${FAKE_GROK_MODE:-ok}"
case "$mode" in
  ok) printf 'Grok Result | grok key info | https://example.com/grok-result\n' ;;
  empty) : ;;
  search-failed) printf 'SEARCH_FAILED\n' ;;
  exit-nonzero) printf 'grok boom\n' >&2; exit 9 ;;
esac
exit 0
