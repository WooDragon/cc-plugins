{
  "description": "Adversarial red-team review on ExitPlanMode via Gemini, Claude, or Codex engine",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plan-review.sh",
            "timeout": 600,
            "statusMessage": "Red Team reviewing plan..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch-check.sh",
            "timeout": 5,
            "statusMessage": "Checking dispatch manifest..."
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/dispatch-check.sh",
            "timeout": 5,
            "statusMessage": "Checking dispatch manifest..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/precompact-review.sh",
            "timeout": 10,
            "statusMessage": "Preserving plan review state..."
          }
        ]
      }
    ]
  }
}
