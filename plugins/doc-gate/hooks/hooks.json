{
  "description": "Document governance: entry-side criteria injection (PostToolUse) + exit-side worktree consistency check (Stop)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/doc-entry.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/doc-exit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
