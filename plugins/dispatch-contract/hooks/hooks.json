{
  "description": "Dispatch contract: %%DONE%% finalization gate on SubagentStop, sync, agent-ownership, capability, and channel guards on PreToolUse, dispatch-rules injection on SubagentStart, auto-compaction reminders on main-session PostToolUse, stateless convergence reminders on completed synchronous Agent/Task PostToolUse",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-sync-guard.sh", "timeout": 5 },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-agent-ownership-guard.sh", "timeout": 5 },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-capability-guard.sh", "timeout": 5 },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/pre-dispatch-channel-guard.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-sync-guard.sh", "timeout": 5 },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-agent-ownership-guard.sh", "timeout": 5 },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-capability-guard.sh", "timeout": 5 },
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/pre-dispatch-channel-guard.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task|SendMessage|TaskOutput)$",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-compact-reminder.sh\"" }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-convergence-reminder.sh\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-rules-inject.sh", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/subagent-done-gate.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
