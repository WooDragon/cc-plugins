---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'figure'> {
  src: string;
  alt?: string;
  ratio?: '16-9' | '4-3' | '1-1' | '3-4';
  fit?: 'cover' | 'contain';
  caption?: string;
}

const { src, alt = '', ratio, fit = 'cover', caption, class: className, ...rest } = Astro.props;
---

<figure {...rest} class:list={['frame-img', ratio && `r-${ratio}`, fit !== 'cover' && `fit-${fit}`, className]}>
  <img src={src} alt={alt} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
