---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  title: string;
  cost: string;
  desc: string;
  items: string[];
  recommended?: boolean;
  badge?: string;
}

const { title, cost, desc, items, recommended = false, badge, class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['option-card', recommended && 'recommended', className]} data-anim>
  {badge && <div class="badge">{badge}</div>}
  <div class="option-title">{title}</div>
  <div class="option-cost">{cost}</div>
  <div class="option-desc">{desc}</div>
  <ul class="option-list">
    {items.map(item => <li>{item}</li>)}
  </ul>
</div>
