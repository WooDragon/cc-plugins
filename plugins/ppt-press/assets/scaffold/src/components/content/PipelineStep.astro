---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  nb: string;
  title: string;
  desc: string;
}

const { nb, title, desc, class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['step', className]} data-anim="step">
  <div class="step-nb">{nb}</div>
  <div class="step-title">{title}</div>
  <div class="step-desc">{desc}</div>
</div>
