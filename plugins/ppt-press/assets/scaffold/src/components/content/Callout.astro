---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  source?: string;
}

const { source, class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['callout', className]} data-anim>
  <slot />
  {source && <div class="callout-src">{source}</div>}
</div>
